    "UNION",
    "INSERT",
    "UPDATE",
    "DELETE",
    "DROP",
    "OR 1=1",
    "OR '1'='1",
    "OR \"1\"=\"1",
    "' OR '",
    "--",
    "#",
    "/*",
    "*/",
    "SLEEP(",
    "BENCHMARK(",
    "WAITFOR DELAY",
    "EXEC(",
    "EXECUTE(",
    "<script>",
    "</script>",
    "javascript:",
    "onerror=",
    "onload=",
    "onclick=",
    "onmouseover=",
    "onfocus=",
    "onblur=",
    "alert(",
    "confirm(",
    "prompt(",
    "document.cookie",
    "eval(",
    "../",
    "..\\",
    "..%2f",
    "..%5c",
    "%2e%2e%2f",
    "%2e%2e/",
    "..%252f",
